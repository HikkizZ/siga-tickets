NODE_ENV=development
PORT=3002
LOG_LEVEL=info

# SQL Server 2025 (instancia por defecto en el host, no en Docker). Base de la app: siga-tickets.
# Los tests usan siga-tickets-test (la crea la suite; DB_NAME lo fija vitest.config.ts).
DB_HOST=localhost
DB_PORT=1433
DB_USER=<usuario-sql>
DB_PASSWORD=<tu-contraseña>
DB_NAME=siga-tickets
# TLS: SQL Server 2025 exige cifrado por defecto. En localhost usa un certificado autofirmado,
# así que en desarrollo se confía en él (DB_TRUST_SERVER_CERTIFICATE=true). Con un certificado
# válido (producción) déjalo en false.
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=true

# Mínimo 32 caracteres. Este valor es solo un placeholder de desarrollo local.
JWT_SECRET=cambia-esto-en-desarrollo-local-0123456789
JWT_EXPIRES_IN=2h

# Admin inicial para `npm run seed`. La contraseña NO va en el repo: defínela en tu .env local.
SEED_ADMIN_USERNAME=admin
SEED_ADMIN_EMAIL=admin@siga-ot.local
SEED_ADMIN_NOMBRE=Administrador
SEED_ADMIN_PASSWORD=
